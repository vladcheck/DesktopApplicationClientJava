<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root" alignment="CENTER"
    fx:controller="com.DesktopApplicationClientJava.controllers.ResourceDetailsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <VBox styleClass="panel, panel-primary" maxWidth="640">
        <VBox styleClass="panel-heading">
            <Label fx:id="titleLabel" styleClass="panel-title" text="..." />
        </VBox>

        <VBox styleClass="panel-body" spacing="8">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12" />
            </padding>

            <Label fx:id="descriptionLabel" wrapText="true" />

            <HBox spacing="8">
                <Label text="Создан:" styleClass="lbl" />
                <Label fx:id="createdLabel" />
            </HBox>

            <HBox spacing="8">
                <Label text="Изменён:" styleClass="lbl" />
                <Label fx:id="updatedLabel" />
            </HBox>

            <HBox spacing="8">
                <Label text="UUID:" styleClass="lbl" />
                <Label fx:id="uuidLabel" style="-fx-font-family: monospace; -fx-font-size: 11;" />
            </HBox>

            <Label fx:id="errorLabel" styleClass="alert, alert-danger" visible="false"
                managed="false" wrapText="true" maxWidth="Infinity" />

            <TableView fx:id="filesTable" prefHeight="200" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Имя" prefWidth="240" />
                    <TableColumn fx:id="sizeColumn" text="Размер" prefWidth="100" />
                    <TableColumn fx:id="contentTypeColumn" text="Тип" prefWidth="160" />
                    <TableColumn fx:id="downloadColumn" text="" prefWidth="110" sortable="false" />
                </columns>
            </TableView>

            <HBox spacing="8">
                <Button fx:id="backButton" text="Назад" onAction="#onBack"
                    styleClass="btn, btn-default" />
                <Label fx:id="statusLabel" styleClass="lbl" />
            </HBox>
        </VBox>
    </VBox>
</VBox>
