<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:id="root"
    fx:controller="com.DesktopApplicationClientJava.controllers.LoginFormController">
    <VBox spacing="5">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10" />
        </padding>

        <Label text="Госхрон" styleClass="h1" />

        <VBox fx:id="formContainer" spacing="5" />

        <Button text="Войти" fx:id="submitButton" onAction="#onSubmit" />
    </VBox>
</VBox>
