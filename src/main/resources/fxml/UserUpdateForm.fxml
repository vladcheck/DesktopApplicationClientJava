<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root"
      fx:controller="com.DesktopApplicationClientJava.controllers.UserUpdateFormController"
      styleClass="auth-bg"
      alignment="TOP_CENTER">

    <VBox styleClass="card-lg"
          spacing="18"
          maxWidth="480">

        <!-- Заголовок -->
        <VBox spacing="4">
            <Label styleClass="card-title" text="Редактирование пользователя"/>
            <Label fx:id="subtitleLabel" styleClass="card-subtitle" text=""/>
        </VBox>

        <!-- Почта -->
        <VBox spacing="6">
            <Label styleClass="field-label" text="Почта" labelFor="$emailField"/>
            <TextField fx:id="emailField"
                       styleClass="text-input"
                       promptText="youremail@example.com"/>
        </VBox>

        <!-- Роль -->
        <VBox spacing="6">
            <Label styleClass="field-label" text="Роль" labelFor="$roleChoiceBox"/>
            <ChoiceBox fx:id="roleChoiceBox"
                       styleClass="combo"
                       maxWidth="Infinity"/>
        </VBox>

        <!-- Имя -->
        <VBox spacing="6">
            <Label styleClass="field-label" text="Имя" labelFor="$firstNameField"/>
            <TextField fx:id="firstNameField"
                       styleClass="text-input"
                       promptText="Иван"/>
        </VBox>

        <!-- Фамилия -->
        <VBox spacing="6">
            <Label styleClass="field-label" text="Фамилия" labelFor="$lastNameField"/>
            <TextField fx:id="lastNameField"
                       styleClass="text-input"
                       promptText="Иванов"/>
        </VBox>

        <!-- Активен -->
        <VBox spacing="6">
            <CheckBox fx:id="enabledCheckBox"
                      text="Учётная запись активна"
                      styleClass="field-label"/>
        </VBox>

        <!-- Ошибка -->
        <Label fx:id="errorLabel"
               styleClass="alert-danger"
               visible="false"
               managed="false"
               wrapText="true"
               maxWidth="Infinity"/>

        <!-- Кнопки -->
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="cancelButton"
                    text="Отмена"
                    onAction="#onCancel"
                    styleClass="btn-ghost"/>
            <Button fx:id="saveButton"
                    text="Сохранить"
                    onAction="#onSave"
                    styleClass="btn-primary"
                    defaultButton="true"/>
        </HBox>

    </VBox>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
</VBox>