<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           styleClass="auth-bg"
           fx:controller="com.DesktopApplicationClientJava.controllers.UsersListController">

    <VBox styleClass="page-shell" spacing="18" maxWidth="1080" maxHeight="Infinity">

        <!-- Шапка -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2">
                <Label text="Госхрон" styleClass="card-title"/>
                <Label text="Управление пользователями" styleClass="card-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="resourcesButton"
                    text="Документы"
                    onAction="#onOpenResources"
                    styleClass="btn-ghost"/>
            <Label fx:id="userInfoLabel" styleClass="user-chip"/>
            <Button fx:id="logoutButton"
                    text="Выйти"
                    onAction="#onLogout"
                    styleClass="btn-ghost"/>
        </HBox>

        <VBox styleClass="card-lg" spacing="16" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Пользователи" styleClass="card-title"/>
                    <Label text="Список всех зарегистрированных пользователей" styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="createButton"
                        text="+ Создать пользователя"
                        onAction="#onCreate"
                        styleClass="btn-primary"/>
            </HBox>

            <!-- Поиск и сортировка -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Поиск по email, имени или фамилии..."
                           onAction="#onSearch"
                           styleClass="text-input"
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="sortCombo"
                          onAction="#onSort"
                          styleClass="combo"
                          prefWidth="220"/>
            </HBox>

            <!-- Ошибка -->
            <Label fx:id="errorLabel"
                   styleClass="alert-danger"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="Infinity"/>

            <!-- Таблица -->
            <TableView fx:id="usersTable"
                       styleClass="modern-table"
                       VBox.vgrow="ALWAYS"
                       prefHeight="380">
                <columns>
                    <TableColumn fx:id="emailColumn"     text="Почта"    prefWidth="240"/>
                    <TableColumn fx:id="firstNameColumn" text="Имя"      prefWidth="140"/>
                    <TableColumn fx:id="lastNameColumn"  text="Фамилия"  prefWidth="160"/>
                    <TableColumn fx:id="roleColumn"      text="Роль"     prefWidth="130"/>
                    <TableColumn fx:id="enabledColumn"   text="Активен"  prefWidth="90"/>
                </columns>
            </TableView>

            <!-- Пагинация -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="pagination">
                <Button fx:id="prevButton"
                        text="← Назад"
                        onAction="#onPrev"
                        styleClass="btn-ghost"/>
                <Label fx:id="pageInfoLabel" styleClass="pagination-info"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" styleClass="pagination-info"/>
                <Button fx:id="nextButton"
                        text="Вперёд →"
                        onAction="#onNext"
                        styleClass="btn-ghost"/>
            </HBox>

        </VBox>
    </VBox>

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>
</StackPane>