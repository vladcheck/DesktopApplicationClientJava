# Example environment for the local test infrastructure (see compose.yaml).
# Copy to .env (gitignored, never commit real secrets):
#   cp .env.example .env

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pks_dev
POSTGRES_USER=pks_user
POSTGRES_PASSWORD=changeme

# --- Backend app settings ---
JWT_SECRET=replace-me-with-64-hex-chars # openssl rand -hex 32
JWT_ACCESS_EXPIRATION_IN_MS=900000 # 15 minutes
JWT_REFRESH_EXPIRATION_IN_MS=604800000 # 7 days
APP_PORT=8080
REDIS_PASSWORD=changeme

# --- MinIO  ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-root
MINIO_BUCKET_NAME=local-bucket
MINIO_ACCESS_TOKEN=changeme-access
MINIO_SECRET_KEY=changeme-secret

# --- App ---
# First page on startup (handy for manual UI checks, e.g. /fxml/ResourceDetails.fxml).
INITIAL_PAGE_PATH=/fxml/LoginForm.fxml
# Run without a backend, on in-memory mock data (for UI testing). Window title gets [MOCK].
MOCK_DATA=false

# --- Integration tests (mvn test -Dgroups=integration -DexcludedGroups=) ---
# Seed admin of the local dev backend; used by *IntegrationTest (skipped if unset).
# Never commit real values here.
IT_ADMIN_EMAIL=admin@example.com
IT_ADMIN_PASSWORD=changeme
