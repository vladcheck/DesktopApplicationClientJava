# Example environment for the local test infrastructure (see compose.yaml).
# Copy to .env (gitignored, never commit real secrets):
#   cp .env.example .env

# --- Postgres ---
POSTGRES_DB=pks_dev
POSTGRES_USER=pks_user
POSTGRES_PASSWORD=changeme

# --- Backend app settings (used by the backend, not by compose) ---
APP_PORT=8080
REDIS_PASSWORD=changeme

# --- MinIO (only needed with: docker compose --profile files up -d) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio-root
MINIO_BUCKET_NAME=local-bucket
MINIO_ACCESS_TOKEN=changeme-access
MINIO_SECRET_KEY=changeme-secret

# --- Integration tests (mvn test -Dgroups=integration -DexcludedGroups=) ---
# Seed admin of the local dev backend; used by *IntegrationTest (skipped if unset).
# Never commit real values here.
IT_ADMIN_EMAIL=admin@example.com
IT_ADMIN_PASSWORD=changeme
