<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="EqualsHashCode"/>
    <module name="UnusedLocalVariable"/>
    <module name="UnusedPrivateField">
      <property
        name="ignoreAnnotationCanonicalNames"
        value="java.io.Serial, javafx.fxml.FXML"/>
    </module>
  </module>
  <!-- Модели на Lombok (@Getter генерирует доступ извне, Checkstyle его не видит):
       поля там используются через сгенерированные геттеры и Jackson-десериализацию. -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="UnusedPrivateField"/>
    <property
      name="files"
      value="(entities|filter|data)[\\/].*\.java|ServiceRegistry\.java"/>
  </module>
</module>